# Copy this file to .env and fill in the key of the provider(s) LiteLLM will use. LiteLLM reads
# these variables directly; Thymira never processes, stores or logs them.
#
# `thymira-api` and the `thymira` CLI load the nearest .env at start-up (--env-file or
# $THYMIRA_ENV_FILE override the search), and docker compose loads it through `env_file`. A
# variable already set in the environment always wins: .env fills gaps, it never overrules a
# shell export, a container's -e or a CI secret. A .env may NOT set PATH, PYTHONPATH, PYTHONHOME,
# PYTHONSTARTUP, PYTHONEXECUTABLE, PYTHONUSERBASE, LD_PRELOAD, LD_LIBRARY_PATH, LD_AUDIT,
# DYLD_INSERT_LIBRARIES, DYLD_LIBRARY_PATH, NODE_OPTIONS, or any *_PROXY name -- the server
# refuses to start rather than let a checked-in file steer which interpreter, shared library or
# proxy every subprocess the runtime launches actually uses; the CLI silently skips such a line
# instead, since it spawns no child. Credentials are not filtered here -- this file is exactly
# where they belong; they are excluded at the sandbox child boundary instead.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------- model routing
# Thymira conventions (not native LiteLLM variables). Model ids use LiteLLM's format: a bare
# name means OpenAI, "<provider>/<model>" routes elsewhere. The values below are placeholders:
# models are configuration, never names in the code or the docs (ADR-0003, ADR-0004).
#
# The two orchestrators can each run on their own frontier model — a different vendor for
# MIRA keeps its judgement independent of THY's blind spots:
THYMIRA_THY_MODEL=<vendor-a>/<frontier-model>
THYMIRA_MIRA_MODEL=<vendor-b>/<frontier-model>
# Shared fallback for both orchestrators when a specific one is not set:
THYMIRA_ORCHESTRATOR_MODEL=

# Tiers for everything else. The router maps the kind of task to a tier (plan/decide/synthesize/
# audit_judgement -> FRONTIER; analyze/code/review -> STANDARD; select_tool/summarize/extract/
# classify/format -> FAST) and every choice is recorded as a model.selected event:
THYMIRA_MODEL_FRONTIER=<vendor-a>/<frontier-model>
THYMIRA_MODEL_STANDARD=<vendor-a>/<mid-model>
THYMIRA_MODEL_FAST=<vendor-a>/<small-fast-model>
# Sub-agents' default when a tier is not set:
THYMIRA_AGENT_MODEL=
# Last-resort fallback for everything:
THYMIRA_MODEL=
# The exact model routes a Session may use, comma-separated (every id named above must be
# listed). Snapshotted into each Session and Run and checked by code after every
# `model.selected` and before the provider call; an unlisted route is refused as a
# `model.route_denied` event. Unset means an EMPTY allowlist: every model call is denied.
THYMIRA_ALLOWED_MODEL_ROUTES=<vendor-a>/<frontier-model>,<vendor-b>/<frontier-model>,<vendor-a>/<mid-model>,<vendor-a>/<small-fast-model>
# Optional: forwarded to LiteLLM as reasoning_effort. Unset leaves the provider default.
# Allowed: none | minimal | low | medium | high | xhigh  (an unknown value fails fast).
# It is one setting for the whole process, but models are routed per tier, so it is sent only to
# models LiteLLM says accept it and dropped for the rest -- every response records which happened.
THYMIRA_REASONING_EFFORT=

# Floors: the cheapest tier a role may run on, whatever it requests (FAST | STANDARD | FRONTIER).
# MIRA defaults to STANDARD so the audit is never cheaper than the work it audits.
THYMIRA_THY_MIN_TIER=FAST
THYMIRA_MIRA_MIN_TIER=STANDARD
THYMIRA_AGENT_MIN_TIER=FAST

# ---------------------------------------------------------------- sandbox backend
# Which backend confines every code-executing tool (run_python, Git, run_experiment,
# inspect_model, audit_model), read once at the composition root
# (configured_builtins_registry()). "container" (the default) runs a hardened Docker
# container per call; "local" refuses every mode but danger_full_access and is the explicit
# development escape hatch. An unknown backend, a non-positive pids limit, or an unknown mode
# fails the process closed rather than silently falling back.
#
# These are listed here for reference only -- neither loader will apply a THYMIRA_SANDBOX_* line
# from a .env file (the server raises EnvFileError; the CLI silently skips it). Backend selection
# is an operator decision read once at the composition root, never a project-declared fact: set
# these as real environment variables (a shell export, a container's -e/environment:, a CI
# secret) instead of writing them into this file.
# THYMIRA_SANDBOX_BACKEND=container
# THYMIRA_SANDBOX_IMAGE=thymira:dev
# THYMIRA_SANDBOX_MEMORY=1g
# THYMIRA_SANDBOX_CPUS=1.0
# THYMIRA_SANDBOX_PIDS_LIMIT=128
# THYMIRA_SANDBOX_OUTPUT_LIMIT_BYTES=8388608
# The current bind-mounted workspace has no quota boundary; setting this causes a fail-closed
# refusal until a quota-capable workspace backend is configured.
# THYMIRA_SANDBOX_WORKSPACE_QUOTA_BYTES=
# Unset by default. Set to danger_full_access only for local, unconfined development -- this is
# the one explicit route to an unconfined child, and it forces every subprocess tool into that
# mode regardless of what it would otherwise request.
# THYMIRA_SANDBOX_MODE=

# ---------------------------------------------------------------- observability
# API request tracing is disabled by default. Set OTEL_TRACES_EXPORTER=otlp and configure the
# standard OTLP endpoint to export spans to a collector; prompts and request bodies are excluded.
OTEL_TRACES_EXPORTER=none
OTEL_SERVICE_NAME=thymira-api
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# ---------------------------------------------------------------- LLM tracing (Langfuse)
# Off unless BOTH keys are set; unset, the SDK is never even imported (ADR-0012). The trace is a
# redacted, non-authoritative mirror -- events.jsonl stays the record -- but it still leaves the
# process, so prefer a self-hosted instance; any *.cloud.langfuse.com host is external egress.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=http://localhost:3000
# Self-hosted above; EU cloud https://cloud.langfuse.com, US https://us.cloud.langfuse.com.
# LANGFUSE_TRACING_ENVIRONMENT=development
# LANGFUSE_RELEASE=
# LANGFUSE_SAMPLE_RATE=1.0
# Set to false to hard-disable tracing even when both keys are present:
# LANGFUSE_TRACING_ENABLED=
